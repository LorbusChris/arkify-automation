# surface (Microsoft Surface, x86_64-only) arkify target
TARGET=surface
SERIES=7.2
CONSUMPTION=copr-surface
COPR_PROJECT=@mobility/surface
# rpm release field. 1000 is a floor, not an identity: it only has to sort
# above Fedora's own kernel release numbers (200.fc44, 61.fc45) so ours wins
# for the same kernel version. The targets do not need different values -
# DISTLOCALVERSION (.surface), the arch and the separate COPR repo already keep
# them apart. Only raise it to force a rebuild of an unchanged version.
RHEL_RELEASE=1000
# notify-only: watch linux-surface for a new patches/<series> directory
NOTIFY_REMOTE=https://github.com/linux-surface/linux-surface
NOTIFY_PATCHDIR=patches
