# surface (Microsoft Surface, x86_64-only) arkify target
TARGET=surface
SERIES=7.2
CONSUMPTION=copr-surface
COPR_PROJECT=@mobility/surface
# rpm release field; distinct from sc7280's 1001 so the two COPR repos never collide on an NVR
RHEL_RELEASE=1002
# notify-only: watch linux-surface for a new patches/<series> directory
NOTIFY_REMOTE=https://github.com/linux-surface/linux-surface
NOTIFY_PATCHDIR=patches
