# sc7280 (Fairphone 5, aarch64-only) arkify target
TARGET=sc7280
SERIES=7.2
CONSUMPTION=copr-sc7280
COPR_PROJECT=@mobility/sc7280
# rpm release field; distinct from surface's 1002 so the two COPR repos never collide on an NVR
RHEL_RELEASE=1001
# notify-only: watch the upstream patch source for movement / new series
NOTIFY_REMOTE=https://github.com/sc7280-mainline/linux
NOTIFY_REF_PREFIX=sc7280-
