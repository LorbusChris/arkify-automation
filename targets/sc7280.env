# sc7280 (Fairphone 5, aarch64-only) arkify target
TARGET=sc7280
SERIES=7.2
CONSUMPTION=copr-sc7280
COPR_PROJECT=@mobility/sc7280
# rpm release field. 1000 is a floor, not an identity: it only has to sort
# above Fedora's own kernel release numbers (200.fc44, 61.fc45) so ours wins
# for the same kernel version. The targets do not need different values -
# DISTLOCALVERSION (.sc7280), the arch and the separate COPR repo already keep
# them apart. Only raise it to force a rebuild of an unchanged version.
RHEL_RELEASE=1000
# notify-only: watch the upstream patch source for movement / new series
NOTIFY_REMOTE=https://github.com/sc7280-mainline/linux
NOTIFY_REF_PREFIX=sc7280-
